# =============================================================================
# Lou's HVAC — Netlify Environment Variables
# =============================================================================
# Import this file in Netlify: Site Settings → Environment Variables → Import
#
# Fill in the values below, then upload. Leave optional vars blank or remove
# them entirely if you don't need that integration yet.
# =============================================================================

# ---------------------------------------------------------------------------
# RESEND (email delivery) — REQUIRED for the contact form to email Lou
# ---------------------------------------------------------------------------
# Sign up at https://resend.com → API Keys → Create API Key
# Then verify the domain "loushvac.com" in Resend → Domains
RESEND_API_KEY=
RESEND_FROM_EMAIL=leads@loushvac.com
RESEND_TO_EMAIL=admin@loushvac.com

# ---------------------------------------------------------------------------
# SUPABASE (lead history database) — OPTIONAL
# ---------------------------------------------------------------------------
# Stores every lead in a database so Lou can see history at /admin/leads/
# Create a free project at https://supabase.com
# Then: Project Settings → API → copy URL and service_role key
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# HOUSECALL PRO (CRM / job management) — OPTIONAL
# ---------------------------------------------------------------------------
# Automatically creates a customer + lead in Lou's HCP account
# HCP admin → Settings → API → Create OAuth app → copy values
HCP_API_BASE=https://api.housecallpro.com
HCP_CLIENT_ID=
HCP_CLIENT_SECRET=
HCP_ACCOUNT_TOKEN=
HCP_API_VERSION=2024-01-01

# ---------------------------------------------------------------------------
# ADMIN (protects the /admin/leads/ page) — RECOMMENDED
# ---------------------------------------------------------------------------
# Choose a strong passcode. Anyone with this passcode can view lead history.
ADMIN_PASSCODE=
