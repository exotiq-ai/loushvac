---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustBar from '../components/TrustBar.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ReviewCard from '../components/ReviewCard.astro';
import CTABanner from '../components/CTABanner.astro';
import ContactForm from '../components/ContactForm.astro';
import { services } from '../content/services.ts';
import { reviews } from '../content/reviews.ts';

const featuredReviews = reviews.filter(r => ['hero', 'service'].includes(r.tier)).slice(0, 6);
const homepageServices = services.slice(0, 6);

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Lou's Heating & Cooling: Denver's Honest HVAC Company",
  "description": "Family-owned HVAC serving the Denver metro since 2014. Flat rate pricing, no upselling, 24/7 emergency service.",
  "url": "https://www.loushvac303.com"
};
---
<BaseLayout
  title="Lou's Heating & Cooling | Lakewood & Denver's Honest HVAC Company | (303) 949-8584"
  description="Family-owned HVAC in Lakewood & the Denver metro. Flat rate pricing, no upselling, 24/7 emergency service. AC repair, furnace repair, swamp cooler service. Call (303) 949-8584."
  canonical="/"
  schema={pageSchema}
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-panel">
      <div class="hero-panel-inner">
        <div class="hero-text">
        <p class="hero-eyebrow">Denver's Most Trusted HVAC Company</p>
        <h1>Honest HVAC Service.<br />Fair Prices. Every Time.</h1>
        <p class="hero-sub">Family-owned. Flat rate pricing. No upselling. Serving the Denver metro since 2014.</p>
        <div class="hero-cta-group">
          <a href="tel:3039498584" class="btn btn-primary btn-lg">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="18" height="18"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.17h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.29 6.29l1.02-.52a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Call (303) 949-8584
          </a>
          <a href="/contact/" class="btn btn-secondary btn-lg">
            Schedule Free Estimate
          </a>
        </div>
        <div class="hero-trust-quick">
          <span class="trust-quick-item">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="14" height="14" class="check-icon"><polyline points="20 6 9 17 4 12"/></svg>
            Free Estimates
          </span>
          <span class="trust-quick-item">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="14" height="14" class="check-icon"><polyline points="20 6 9 17 4 12"/></svg>
            24/7 Emergency
          </span>
          <span class="trust-quick-item">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="14" height="14" class="check-icon"><polyline points="20 6 9 17 4 12"/></svg>
            BBB A+
          </span>
          <span class="trust-quick-item">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="14" height="14" class="check-icon"><polyline points="20 6 9 17 4 12"/></svg>
            No Hidden Fees
          </span>
        </div>
        </div>
      </div>
    </div>
    <div class="hero-photo">
      <div class="hero-photo-frame">
        <picture class="hero-media">
        <source
          type="image/webp"
          srcset="/images/team-hero-640.webp 640w, /images/team-hero-1024.webp 1024w, /images/team-hero-1600.webp 1600w, /images/team-hero-2400.webp 2400w"
          sizes="(min-width: 900px) 56vw, 100vw"
        />
        <img
          src="/images/team-hero-1600.jpg"
          srcset="/images/team-hero-640.jpg 640w, /images/team-hero-1024.jpg 1024w, /images/team-hero-1600.jpg 1600w, /images/team-hero-2400.jpg 2400w"
          sizes="(min-width: 900px) 56vw, 100vw"
          alt="Lou Hernandez and the Lou's Heating & Cooling family team standing in front of their branded service truck in Lakewood, Colorado"
          width="2400"
          height="1600"
          fetchpriority="high"
          decoding="async"
        />
        </picture>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <TrustBar />

  <!-- WHY LOU'S -->
  <section class="section">
    <div class="container">
      <div class="section-intro text-center">
        <h2>Why Homeowners Choose Lou's</h2>
        <p class="section-intro-sub">We've heard what people say about other HVAC companies. We built Lou's to be the opposite.</p>
      </div>
      <div class="differentiators grid-2">
        <div class="differentiator">
          <div class="diff-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="36" height="36"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
          </div>
          <h3>We'll never sell you something you don't need</h3>
          <blockquote>
            "I can imagine if I had called one of the larger 'service provider' companies, I would have been informed I need a new unit. Thanks again for your honesty."
          </blockquote>
          <p>We diagnose what's actually wrong and fix it. If a $150 repair keeps your system running five more years, that's what we'll recommend. Period.</p>
        </div>
        <div class="differentiator">
          <div class="diff-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="36" height="36"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </div>
          <h3>We show up fast and explain everything</h3>
          <blockquote>
            "He showed up first thing knowing that we were in for another 95 degree day."
          </blockquote>
          <p>We answer calls 24/7 and get to you quickly. When we arrive, we don't just fix it and leave. We explain what was wrong and how to prevent it in the future.</p>
        </div>
        <div class="differentiator">
          <div class="diff-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="36" height="36"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
          </div>
          <h3>Flat rate pricing. No hidden fees. Ever.</h3>
          <blockquote>
            "Stuck to the original quoted price. Very friendly also."
          </blockquote>
          <p>We quote you a flat rate before we start any work. What we quote is what you pay. Free estimates, military discount available, no overtime charges sprung on you after the fact.</p>
        </div>
        <div class="differentiator">
          <div class="diff-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="36" height="36"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <h3>Owner-operated &mdash; every time, no subcontractors</h3>
          <blockquote>
            "Lou was among the most pleasant and professional tradesman and individual I have ever hired."
          </blockquote>
          <p>When you call Lou's, Lou shows up. You're not getting a rotating cast of subcontractors from a call center. This is Lou's business, his name, and his reputation on the line every single time.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-intro text-center">
        <h2>HVAC Services in Denver</h2>
        <p class="section-intro-sub">From emergency repairs to new equipment installations, we handle it all.</p>
      </div>
      <div class="grid-3 services-grid">
        {homepageServices.map(service => (
          <ServiceCard
            title={service.shortTitle}
            description={service.description}
            icon={service.icon}
            href={`/services/${service.slug}/`}
          />
        ))}
      </div>
      <p class="services-footer text-center">
        Not sure what you need? <a href="tel:3039498584" class="phone-link">(303) 949-8584</a>. We'll help you figure it out.
      </p>
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="section">
    <div class="container">
      <div class="section-intro text-center">
        <h2>What Denver Homeowners Say</h2>
        <p class="section-intro-sub">&#9733;&#9733;&#9733;&#9733;&#9733; 5.0 stars across 50+ verified reviews on Google, HomeAdvisor, and Yelp</p>
      </div>
      <div class="grid-3 reviews-grid">
        {featuredReviews.map((review, i) => (
          <ReviewCard review={review} featured={i === 0} />
        ))}
      </div>
      <div class="reviews-footer text-center">
        <a href="/reviews/" class="btn btn-outline">Read All Reviews</a>
        <div class="review-platform-links">
          <a href="https://www.homeadvisor.com/rated.LousHeatingandCooling.141784599.html" target="_blank" rel="noopener noreferrer">HomeAdvisor</a>
          <a href="https://www.yelp.com/biz/lou-s-heating-and-cooling-denver" target="_blank" rel="noopener noreferrer">Yelp</a>
          <a href="https://www.angi.com/companylist/us/co/denver/lous-heating-and-cooling-llc-reviews-1.htm" target="_blank" rel="noopener noreferrer">Angi</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT PREVIEW -->
  <section class="section section-alt">
    <div class="container about-preview">
      <div class="about-preview-img">
        <picture>
          <source
            type="image/webp"
            srcset="/images/lou-about-600.webp 600w, /images/lou-about-900.webp 900w"
            sizes="(min-width: 768px) 420px, 90vw"
          />
          <img
            src="/images/lou-about-600.jpg"
            srcset="/images/lou-about-600.jpg 600w, /images/lou-about-900.jpg 900w"
            sizes="(min-width: 768px) 420px, 90vw"
            alt="Lou Hernandez holding his young son in front of the Lou's Heating & Cooling service truck"
            width="900"
            height="1350"
            loading="lazy"
          />
        </picture>
      </div>
      <div class="about-preview-text">
        <p class="hero-eyebrow">Meet Lou</p>
        <h2>Colorado's Honest HVAC Guy</h2>
        <p>Lou Hernandez has been working on HVAC systems in Denver since 2014. He started Lou's Heating &amp; Cooling because he kept seeing homeowners get pushed into replacements they didn't need by companies that profit from upselling.</p>
        <p>His approach is simple: figure out what's actually wrong, explain it clearly, fix it for a fair price. No mystery charges, no unnecessary repairs, no jargon.</p>
        <a href="/about/" class="btn btn-outline">Our Full Story &rarr;</a>
      </div>
    </div>
  </section>

  <!-- SERVICE AREA PREVIEW -->
  <section class="section">
    <div class="container text-center">
      <h2>Serving the Denver Metro</h2>
      <p class="section-intro-sub">From the foothills to the suburbs. If you're in the Denver metro, we're your HVAC team.</p>
      <div class="service-area-cities">
        <span>Denver</span><span>Lakewood</span><span>Arvada</span><span>Westminster</span>
        <span>Littleton</span><span>Wheat Ridge</span><span>Englewood</span><span>Aurora</span>
        <span>Thornton</span><span>Golden</span><span>Morrison</span><span>Evergreen</span>
        <span>Centennial</span><span>Cherry Hills</span><span>+ more</span>
      </div>
      <a href="/service-area/" class="btn btn-outline">See Full Service Area</a>
    </div>
  </section>

  <!-- EMERGENCY CTA BANNER -->
  <CTABanner
    heading="HVAC Emergency? We're Here 24/7."
    subtext="Same-day service available. Call right now. A real person answers."
    dark={true}
  />

  <!-- CONTACT FORM -->
  <section class="section section-alt" id="contact">
    <div class="container-narrow">
      <div class="section-intro text-center">
        <h2>Schedule Your Free Estimate</h2>
        <p class="section-intro-sub">Fill out the form below and we'll be in touch within 2 hours during business hours. For urgent needs, call <a href="tel:3039498584" class="phone-link">(303) 949-8584</a>.</p>
      </div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>

<style>
/* Hero — premium split; palette matches TrustBar below for one continuous band */
.hero {
  display: grid;
  grid-template-columns: 1fr;
  background: linear-gradient(135deg, #0f2d42 0%, #163d56 40%, var(--color-primary) 70%, #1e5778 100%);
}
.hero-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-10) var(--space-5);
  position: relative;
  overflow: hidden;
}
/* Soft light behind the glass card */
.hero-panel::before {
  content: '';
  position: absolute;
  left: 5%;
  top: 15%;
  width: min(420px, 90%);
  height: 70%;
  background: radial-gradient(
    ellipse at 30% 40%,
    rgba(95, 168, 211, 0.35) 0%,
    rgba(95, 168, 211, 0.08) 45%,
    transparent 72%
  );
  filter: blur(28px);
  pointer-events: none;
  z-index: 0;
}
.hero-panel::after {
  content: '';
  position: absolute;
  right: 0;
  top: 12%;
  bottom: 12%;
  width: 1px;
  background: linear-gradient(
    to bottom,
    transparent,
    rgba(95, 168, 211, 0.35) 25%,
    rgba(255, 255, 255, 0.2) 50%,
    rgba(95, 168, 211, 0.35) 75%,
    transparent
  );
  display: none;
  z-index: 2;
}
.hero-panel-inner {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 520px;
  padding: var(--space-9) var(--space-7);
  border-radius: calc(var(--border-radius-lg) + 4px);
  overflow: hidden;
  isolation: isolate;
  background:
    linear-gradient(
      125deg,
      rgba(255, 255, 255, 0.22) 0%,
      rgba(255, 255, 255, 0.06) 38%,
      transparent 62%
    ),
    linear-gradient(
      160deg,
      rgba(255, 255, 255, 0.12) 0%,
      rgba(95, 168, 211, 0.08) 55%,
      rgba(15, 45, 66, 0.25) 100%
    );
  -webkit-backdrop-filter: blur(22px) saturate(175%);
  backdrop-filter: blur(22px) saturate(175%);
  border: 1px solid rgba(255, 255, 255, 0.28);
  border-top-color: rgba(255, 255, 255, 0.42);
  box-shadow:
    0 16px 48px rgba(0, 0, 0, 0.28),
    0 4px 16px rgba(95, 168, 211, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.35),
    inset 0 -12px 32px rgba(0, 0, 0, 0.08);
}
@supports not (backdrop-filter: blur(1px)) {
  .hero-panel-inner {
    background: rgba(22, 61, 86, 0.92);
  }
}
.hero-panel-inner::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  padding: 1.5px;
  background: linear-gradient(
    145deg,
    rgba(255, 255, 255, 0.55) 0%,
    rgba(95, 168, 211, 0.45) 35%,
    rgba(30, 87, 120, 0.35) 70%,
    rgba(255, 255, 255, 0.2) 100%
  );
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
  z-index: 2;
}
.hero-panel-inner::after {
  content: '';
  position: absolute;
  top: 0;
  left: 8%;
  right: 8%;
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.75) 20%,
    rgba(95, 168, 211, 0.9) 50%,
    rgba(255, 255, 255, 0.75) 80%,
    transparent
  );
  pointer-events: none;
  z-index: 3;
}
.hero-text {
  position: relative;
  z-index: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
}
.hero-photo {
  display: flex;
  align-items: stretch;
  justify-content: center;
  padding: var(--space-6) var(--space-5) var(--space-8);
  min-height: 300px;
}
.hero-photo-frame {
  position: relative;
  flex: 1;
  max-width: 100%;
  border-radius: var(--border-radius-lg);
  padding: 3px;
  background: linear-gradient(
    155deg,
    rgba(95, 168, 211, 0.75) 0%,
    rgba(255, 255, 255, 0.35) 40%,
    rgba(30, 87, 120, 0.8) 75%,
    rgba(95, 168, 211, 0.7) 100%
  );
  box-shadow:
    0 12px 40px rgba(0, 0, 0, 0.28),
    0 0 0 1px rgba(255, 255, 255, 0.08);
  overflow: hidden;
  min-height: 260px;
}
.hero-photo-frame::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: calc(var(--border-radius-lg) - 2px);
  pointer-events: none;
  box-shadow: inset 0 0 80px rgba(18, 51, 71, 0.15);
  z-index: 2;
}
.hero-media {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 254px;
  border-radius: calc(var(--border-radius-lg) - 3px);
  overflow: hidden;
}
.hero-media img {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 254px;
  object-fit: cover;
  object-position: center 32%;
}

@media (min-width: 900px) {
  .hero {
    grid-template-columns: minmax(400px, 44%) 1fr;
    min-height: clamp(540px, 78vh, 740px);
    gap: var(--space-2);
  }
  .hero-panel {
    padding: var(--space-10) var(--space-6) var(--space-10) clamp(var(--space-8), 4vw, var(--space-12));
  }
  .hero-panel::after {
    display: block;
  }
  .hero-panel-inner {
    padding: var(--space-10) var(--space-10);
    border-radius: 1.25rem;
  }
  .hero h1 {
    font-size: clamp(1.75rem, 1.6vw + 0.85rem, 2.125rem);
    margin-bottom: var(--space-6);
  }
  .hero-sub {
    margin-bottom: var(--space-8);
  }
  .hero-photo {
    padding: var(--space-10) clamp(var(--space-8), 3vw, var(--space-12)) var(--space-10) var(--space-6);
    min-height: 100%;
  }
  .hero-photo-frame {
    position: relative;
    min-height: 100%;
    height: 100%;
    border-radius: var(--border-radius-lg) 0 0 var(--border-radius-lg);
  }
  .hero-media {
    position: absolute;
    inset: 3px;
    min-height: 0;
    border-radius: calc(var(--border-radius-lg) - 3px) 0 0 calc(var(--border-radius-lg) - 3px);
  }
  .hero-media,
  .hero-media img {
    position: absolute;
    inset: 0;
    min-height: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }
}
.hero-eyebrow {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  gap: var(--space-2);
  color: rgba(255, 255, 255, 0.95);
  font-size: 0.6875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin: 0 0 var(--space-5);
  padding: 0.4rem 0.85rem;
  border-radius: var(--border-radius-full);
  background: rgba(95, 168, 211, 0.18);
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.28);
  box-shadow:
    0 2px 8px rgba(0, 0, 0, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.2);
  line-height: 1.3;
}
.hero-eyebrow::before {
  content: '';
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--color-accent);
  box-shadow: 0 0 6px rgba(242, 140, 40, 0.55);
  flex-shrink: 0;
}
.hero h1 {
  color: var(--color-white);
  font-size: clamp(1.625rem, 2.4vw + 0.65rem, 2.25rem);
  font-weight: 700;
  line-height: 1.22;
  margin: 0 0 var(--space-5);
  letter-spacing: -0.025em;
  text-wrap: balance;
  text-shadow: 0 2px 20px rgba(0, 0, 0, 0.18);
}
.hero-sub {
  color: rgba(255, 255, 255, 0.9);
  font-size: clamp(0.9375rem, 1.1vw + 0.5rem, 1.0625rem);
  line-height: 1.55;
  margin: 0 0 var(--space-7);
  padding: var(--space-3) 0 var(--space-3) var(--space-4);
  border-left: 2px solid rgba(95, 168, 211, 0.55);
  max-width: 38ch;
}
.hero-cta-group {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  margin: 0 0 var(--space-6);
  width: 100%;
}
.hero-cta-group .btn {
  width: 100%;
  justify-content: center;
}
.hero-cta-group .btn-primary {
  box-shadow: 0 4px 14px rgba(242, 140, 40, 0.35);
}
.hero-cta-group .btn-primary:hover {
  box-shadow: 0 6px 20px rgba(242, 140, 40, 0.45);
}
@media (min-width: 520px) {
  .hero-cta-group {
    flex-direction: row;
    flex-wrap: wrap;
  }
  .hero-cta-group .btn {
    width: auto;
    flex: 1 1 auto;
    min-width: min(100%, 12rem);
  }
}
.hero-trust-quick {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-2);
  margin: 0;
  padding-top: var(--space-5);
  border-top: 1px solid rgba(255, 255, 255, 0.14);
}
.trust-quick-item {
  color: rgba(255, 255, 255, 0.95);
  font-size: 0.6875rem;
  font-weight: 600;
  line-height: 1.25;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  padding: 0.45rem 0.5rem;
  border-radius: var(--border-radius-full);
  background: rgba(255, 255, 255, 0.08);
  -webkit-backdrop-filter: blur(8px);
