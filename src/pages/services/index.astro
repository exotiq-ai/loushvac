---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CTABanner from '../../components/CTABanner.astro';
import { services } from '../../content/services.ts';
import { business } from '../../content/business';
---
<BaseLayout
  title="HVAC Services in Lakewood & Denver Metro, CO | Lou's Heating & Cooling"
  description="Heating and cooling services for homes and commercial enquiries in Lakewood and the Denver metro. Carrier and American Standard equipment. Call (303) 949-8584."
  canonical="/services/"
>
  <section class="page-hero section-primary section-sm">
    <div class="container text-center">
      <h1>HVAC Services in Lakewood & the Denver Metro</h1>
      <p>Heating, cooling and equipment replacement, with clear advice before you decide.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="grid-3">
        {services.map(service => (
          <ServiceCard
            title={service.title}
            description={service.description}
            icon={service.icon}
            href={`/services/${service.slug}/`}
          />
        ))}
        <ServiceCard title={business.commercial.title} description={business.commercial.description} icon="/images/service-icon-fan.png" href="/services/commercial-hvac/" />
      </div>
    </div>
  </section>
  <CTABanner />
</BaseLayout>
