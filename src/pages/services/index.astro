---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CTABanner from '../../components/CTABanner.astro';
import { services } from '../../content/services.ts';
---
<BaseLayout
  title="Air Conditioning, Heating & HVAC Services in Lakewood & Denver Metro, CO | Lou's Heating & Cooling"
  description="Complete air conditioning, heating, and HVAC services across the Denver metro: AC repair, furnace repair, heating system installation, swamp cooler service, maintenance, and 24/7 emergency. Call (303) 949-8584."
  canonical="/services/"
>
  <section class="page-hero section-primary section-sm">
    <div class="container text-center">
      <h1>Air Conditioning, Heating & HVAC Services in Lakewood & the Denver Metro</h1>
      <p>Air conditioning repair, furnace and heating service, swamp cooler maintenance, and 24/7 emergency HVAC — all with honest diagnosis and flat-rate pricing.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="grid-3">
        {services.map(service => (
          <ServiceCard
            title={service.title}
            description={service.description}
            icon={service.icon}
            href={`/services/${service.slug}/`}
          />
        ))}
      </div>
    </div>
  </section>
  <CTABanner />
</BaseLayout>
