---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import CTABanner from '../../components/CTABanner.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { services } from '../../content/services.ts';
import { reviews } from '../../content/reviews.ts';
import type { Service } from '../../content/services.ts';

const heatingReviews = reviews.filter(r => r.service === 'furnace').slice(0, 2);
const furnaceRepair = services.find(s => s.slug === 'furnace-repair')!;
const furnaceReplacement = services.find(s => s.slug === 'furnace-replacement')!;
const emergency = services.find(s => s.slug === 'emergency')!;
const maintenance = services.find(s => s.slug === 'maintenance')!;

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Heating Services in Denver, CO",
  "description": "Complete heating services for Denver metro homes: furnace repair, heating system installation, heat pump service, and emergency heating repair. Available 24/7.",
  "provider": {
    "@type": "HVACBusiness",
    "name": "Lou's Heating & Cooling",
    "telephone": "+13039498584",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1880 S Pierce St #5",
      "addressLocality": "Lakewood",
      "addressRegion": "CO",
      "postalCode": "80232",
      "addressCountry": "US"
    }
  },
  "areaServed": [
    { "@type": "City", "name": "Lakewood, CO" },
    { "@type": "City", "name": "Denver, CO" },
    { "@type": "City", "name": "Arvada, CO" },
    { "@type": "City", "name": "Wheat Ridge, CO" },
    { "@type": "City", "name": "Westminster, CO" },
    { "@type": "City", "name": "Golden, CO" },
    { "@type": "City", "name": "Littleton, CO" },
    { "@type": "City", "name": "Englewood, CO" },
    { "@type": "City", "name": "Aurora, CO" },
    { "@type": "City", "name": "Thornton, CO" }
  ],
  "url": "https://www.loushvac303.com/services/heating/"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.loushvac303.com/" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.loushvac303.com/services/" },
    { "@type": "ListItem", "position": 3, "name": "Heating Services", "item": "https://www.loushvac303.com/services/heating/" }
  ]
};
---
<BaseLayout
  title="Heating Repair & Installation Denver CO | Furnace Service | Lou's Heating & Cooling"
  description="Heating repair and furnace service in Denver, CO. Furnace not working? 24/7 emergency heating repair, new heating system installation. Honest diagnosis, flat rate pricing. Call (303) 949-8584."
  canonical="/services/heating/"
  schema={[pageSchema, breadcrumbSchema]}
>
  <section class="service-hero section-primary section-sm">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> &rsaquo; <a href="/services/">Services</a> &rsaquo; Heating Services
      </nav>
      <h1>Heating Services in Denver, CO</h1>
      <div class="service-hero-cta">
        <a href="tel:3039498584" class="btn btn-primary btn-lg">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="18" height="18"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.17h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.29 6.29l1.02-.52a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call (303) 949-8584
        </a>
        <a href="/contact/" class="btn btn-secondary">Schedule Free Estimate</a>
      </div>
    </div>
  </section>

  <div class="container service-layout">
    <main class="service-main">
      <section class="service-section">
        <p class="service-intro">Denver winters aren't mild. With a design temperature of 1-5°F and 40-degree temperature swings in a single day, your heating system isn't optional — it's essential. Lou's Heating & Cooling has been keeping Denver-metro homes warm since 2014. Whether you need furnace repair, a complete heating system replacement, or emergency heating service at 2am on a January night, we handle it with honest diagnosis and flat-rate pricing.</p>
        <p class="service-intro">At 5,280 feet, heating in Denver is different from heating at sea level. Gas furnaces lose roughly 4% of their rated BTU capacity per 1,000 feet of elevation — a 100,000 BTU furnace in Denver effectively delivers about 80,000 BTU. Colorado homes typically need 25-40 BTU per square foot for heating, compared to 20-25 BTU in milder-climate states. We size every heating system correctly for altitude, insulation, and your home's actual needs.</p>
      </section>

      <section class="service-section">
        <h2>Our Heating Services</h2>
        <div class="heating-services-list">
          <div class="heating-service-item">
            <h3><a href="/services/furnace-repair/">Furnace Repair</a></h3>
            <p>Furnace blowing cold air? Short-cycling? Making strange noises? We diagnose furnace problems honestly and repair them fast. Safety checks (carbon monoxide, gas leaks, heat exchanger inspection) come first on every call. Available 24/7 for heating emergencies.</p>
            <a href="/services/furnace-repair/" class="service-link">Learn about furnace repair &rarr;</a>
          </div>
          <div class="heating-service-item">
            <h3><a href="/services/furnace-replacement/">Furnace & Heating System Installation</a></h3>
            <p>When your furnace is beyond economical repair, we install new heating equipment sized correctly for Denver's altitude. Authorized Carrier Dealer with 10-year extended warranty. We run a proper Manual J load calculation — not a guess based on square footage. Free in-home estimates.</p>
            <a href="/services/furnace-replacement/" class="service-link">Learn about furnace installation &rarr;</a>
          </div>
          <div class="heating-service-item">
            <h3><a href="/services/emergency/">Emergency Heating Repair</a></h3>
            <p>No heat at midnight in January? We answer the phone 24/7. No answering service, no "we'll call you Monday." We aim to reach Denver-metro homes within 2-4 hours for heating emergencies.</p>
            <a href="/services/emergency/" class="service-link">Learn about emergency service &rarr;</a>
          </div>
          <div class="heating-service-item">
            <h3><a href="/services/maintenance/">Heating System Maintenance</a></h3>
            <p>A fall tune-up catches failing parts before they cause a mid-winter breakdown. Furnace tune-ups include heat exchanger inspection, combustion safety testing, burner cleaning, and a full system performance test. Book in September or October, before the rush.</p>
            <a href="/services/maintenance/" class="service-link">Learn about maintenance &rarr;</a>
          </div>
        </div>
      </section>

      <section class="service-section">
        <h2>Signs Your Heating System Needs Attention</h2>
        <ul class="symptom-list">
          <li>
            <svg class="symptom-check" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16"><polyline points="20 6 9 17 4 12"/></svg>
            Furnace won't turn on or won't stay running
          </li>
          <li>
            <svg class="symptom-check" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16"><polyline points="20 6 9 17 4 12"/></svg>
            Heating system blowing cold or lukewarm air
          </li>
          <li>
            <svg class="symptom-check" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16"><polyline points="20 6 9 17 4 12"/></svg>
            Unusual smells from the furnace (burning, gas, or musty)
          </li>
          <li>
            <svg class="symptom-check" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16"><polyline points="20 6 9 17 4 12"/></svg>
            Carbon monoxide detector alarming near the furnace
          </li>
          <li>
            <svg class="symptom-check" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16"><polyline points="20 6 9 17 4 12"/></svg>
            Gas bills climbing without changes in usage
          </li>
          <li>
            <svg class="symptom-check" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16"><polyline points="20 6 9 17 4 12"/></svg>
            Furnace is 15+ years old and needing frequent repairs
          </li>
          <li>
            <svg class="symptom-check" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16"><polyline points="20 6 9 17 4 12"/></svg>
            Uneven heating between rooms or floors
          </li>
        </ul>
      </section>

      {heatingReviews.length > 0 && (
        <section class="service-section">
          <h2>What Customers Say About Our Heating Service</h2>
          <div class="service-reviews">
            {heatingReviews.map(review => (
              <ReviewCard review={review} />
            ))}
          </div>
        </section>
      )}

      <section class="service-commitment">
        <h2>Denver Heating Expertise You Can Trust</h2>
        <p>Lou's Heating & Cooling isn't a franchise. It's Lou and Nester — the same names on every job. When you call for heating service, you get someone who has been working on furnaces and heating systems in the Denver metro since 2014. We know how altitude affects gas combustion, how older Lakewood ductwork handles modern equipment, and which heating systems hold up best through Colorado winters. No mystery charges. No pushing you toward equipment you don't need. Just honest heating repair and installation, priced fairly.</p>
      </section>
    </main>

    <aside class="service-sidebar">
      <div class="sidebar-cta">
        <h3>Need Heating Service?</h3>
        <a href="tel:3039498584" class="btn btn-primary btn-lg" style="width:100%; text-align:center; display:flex; align-items:center; justify-content:center; gap:8px;">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.17h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.29 6.29l1.02-.52a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          (303) 949-8584
        </a>
        <p class="sidebar-or">or</p>
        <a href="/contact/" class="btn btn-outline" style="width:100%; text-align:center; display:block;">
          Schedule Online
        </a>
        <ul class="sidebar-badges">
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="14" height="14"><polyline points="20 6 9 17 4 12"/></svg>
            Free Estimates
          </li>
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="14" height="14"><polyline points="20 6 9 17 4 12"/></svg>
            Flat Rate Pricing
          </li>
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="14" height="14"><polyline points="20 6 9 17 4 12"/></svg>
            BBB A+ Rated
          </li>
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="14" height="14"><polyline points="20 6 9 17 4 12"/></svg>
            24/7 Heating Emergency
          </li>
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="14" height="14"><polyline points="20 6 9 17 4 12"/></svg>
            Serving Denver Since 2014
          </li>
        </ul>
      </div>
    </aside>
  </div>

  <CTABanner heading="Heating Emergency? We're Available 24/7." subtext="No heat in your Denver home? Call right now. A real person answers." dark={true} />
</BaseLayout>

<style>
.service-hero { padding: var(--space-12) 0; }
.service-hero h1 { color: var(--color-white); margin-bottom: var(--space-6); }
.breadcrumb { color: rgba(255,255,255,0.7); font-size: var(--font-size-sm); margin-bottom: var(--space-3); }
.breadcrumb a { color: rgba(255,255,255,0.8); text-decoration: none; }
.breadcrumb a:hover { color: white; }
.service-hero-cta { display: flex; gap: var(--space-3); flex-wrap: wrap; }
.service-layout { display: grid; grid-template-columns: 1fr; gap: var(--space-10); padding-top: var(--space-10); padding-bottom: var(--space-10); }
@media (min-width: 1024px) { .service-layout { grid-template-columns: 1fr 320px; } }
.service-section { margin-bottom: var(--space-10); }
.service-section h2 { margin-bottom: var(--space-4); color: var(--color-primary); }
.service-intro { font-size: var(--font-size-lg); line-height: 1.8; color: var(--color-text-muted); margin-bottom: var(--space-4); }
.heating-services-list { display: flex; flex-direction: column; gap: var(--space-6); }
.heating-service-item { padding: var(--space-6); background: var(--color-bg-alt); border-radius: var(--border-radius-lg); border-left: 4px solid var(--color-accent); }
.heating-service-item h3 { margin-bottom: var(--space-2); }
.heating-service-item h3 a { color: var(--color-primary); text-decoration: none; }
.heating-service-item h3 a:hover { color: var(--color-accent); }
.heating-service-item p { color: var(--color-text-muted); margin-bottom: var(--space-3); }
.service-link { color: var(--color-accent); font-weight: 600; text-decoration: none; }
.service-link:hover { text-decoration: underline; }
.symptom-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: var(--space-3); }
.symptom-list li { display: flex; align-items: flex-start; gap: var(--space-3); padding: var(--space-3); background: var(--color-bg-alt); border-radius: var(--border-radius); }
.symptom-check { color: var(--color-success); flex-shrink: 0; margin-top: 2px; }
.service-reviews { display: flex; flex-direction: column; gap: var(--space-4); }
.service-commitment { background: var(--color-bg-alt); border-radius: var(--border-radius-lg); padding: var(--space-6); margin-bottom: var(--space-10); }
.service-commitment h2 { color: var(--color-primary); margin-bottom: var(--space-4); }
.service-commitment p { color: var(--color-text-muted); line-height: 1.8; }
.sidebar-cta { background: var(--color-bg-alt); border-radius: var(--border-radius-lg); padding: var(--space-6); position: sticky; top: 90px; }
.sidebar-cta h3 { margin-bottom: var(--space-4); }
.sidebar-or { text-align: center; color: var(--color-text-muted); margin: var(--space-3) 0; font-size: var(--font-size-sm); }
.sidebar-badges { list-style: none; padding: 0; margin-top: var(--space-4); display: flex; flex-direction: column; gap: var(--space-2); }
.sidebar-badges li { font-size: var(--font-size-sm); color: var(--color-text-muted); padding-left: 0; display: flex; align-items: center; gap: 6px; }
.sidebar-badges svg { color: var(--color-success); flex-shrink: 0; }
.btn-outline { background: transparent; color: var(--color-primary); border-color: var(--color-primary); }
.btn-outline:hover { background: var(--color-primary); color: var(--color-white); }
</style>
