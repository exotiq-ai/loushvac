---
// src/components/Header.astro
const navLinks = [
  { href: '/services/', label: 'Services' },
  { href: '/services/emergency/', label: 'Emergency' },
  { href: '/reviews/', label: 'Reviews' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/service-area/', label: 'Service Area' },
  { href: '/contact/', label: 'Contact' },
];
const currentPath = Astro.url.pathname;
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo-link" aria-label="Lou's Heating & Cooling">
      <picture>
        <source type="image/webp" srcset="/images/lous-hvac-logo.webp" width="600" height="229" />
        <img src="/images/lous-hvac-logo.png" alt="Lou's Heating & Cooling logo — HVAC contractor in Lakewood, CO" width="1500" height="1000" />
      </picture>
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`nav-link ${currentPath.startsWith(link.href) ? 'active' : ''}`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="header-cta">
      <a href="tel:3039498584" class="header-phone">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="18" height="18"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.17h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.29 6.29l1.02-.52a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        (303) 949-8584
      </a>
      <a href="/contact/" class="btn btn-primary header-schedule-btn">
        Request Service
      </a>
    </div>

    <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-hidden="true" aria-label="Mobile navigation">
    {navLinks.map(link => (
      <a href={link.href} class="mobile-nav-link">{link.label}</a>
    ))}
    <a href="tel:3039498584" class="mobile-nav-phone">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="18" height="18"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.17h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.29 6.29l1.02-.52a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      (303) 949-8584
    </a>
    <a href="/contact/" class="btn btn-primary mobile-nav-cta">Request Service</a>
  </nav>
</header>

<style>
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--color-white);
  box-shadow: var(--shadow-md);
}
.header-inner {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  height: 64px; /* Compact mobile header */
}
.logo-link img { height: 52px; width: auto; }
@media (min-width: 768px) { .header-inner { height: 80px; } .logo-link img { height: 64px; } }
.desktop-nav {
  display: none;
  align-items: center;
  gap: var(--space-2);
  margin-left: auto;
}
@media (min-width: 1200px) { .desktop-nav { display: flex; } }
.nav-link {
  padding: var(--space-2) var(--space-3);
  border-radius: var(--border-radius);
  text-decoration: none;
  color: var(--color-text);
  font-size: var(--font-size-sm);
  font-weight: 500;
  transition: color var(--transition), background var(--transition);
}
.nav-link:hover, .nav-link.active {
  color: var(--color-primary);
  background: var(--color-bg-alt);
}
.header-cta {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-left: auto;
}
@media (min-width: 1200px) { .header-cta { margin-left: 0; } }
.header-phone {
  display: none;
  align-items: center;
  gap: var(--space-1);
  color: var(--color-primary);
  font-weight: 700;
  font-size: var(--font-size-base);
  text-decoration: none;
}
.header-phone:hover { color: var(--color-accent-text); }
@media (min-width: 640px) { .header-phone { display: flex; } }
.header-schedule-btn { display: none; }
@media (min-width: 768px) { .header-schedule-btn { display: inline-flex; } }
.mobile-menu-btn {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  width: 44px;
  height: 44px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 12px 8px;
}
@media (min-width: 1200px) { .mobile-menu-btn { display: none; } }
.mobile-menu-btn span {
  display: block;
  height: 2px;
  background: var(--color-text);
  border-radius: 2px;
  transition: all var(--transition);
}
.mobile-nav {
  display: none;
  flex-direction: column;
  padding: var(--space-4);
  border-top: 1px solid var(--color-border);
  background: var(--color-white);
}
.mobile-nav.open { display: flex; max-height: calc(100dvh - 160px); overflow-y: auto; overscroll-behavior: contain; }
.mobile-nav-link {
  padding: var(--space-3) var(--space-2);
  color: var(--color-text);
  text-decoration: none;
  font-size: var(--font-size-base);
  font-weight: 500;
  border-bottom: 1px solid var(--color-border);
}
.mobile-nav-link:hover { color: var(--color-primary); }
.mobile-nav-phone {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-3) var(--space-2);
  color: var(--color-primary);
  font-weight: 700;
  text-decoration: none;
  font-size: var(--font-size-lg);
}
.mobile-nav-cta { margin-top: var(--space-3); text-align: center; flex-shrink: 0; }
</style>

<script>
const btn = document.querySelector<HTMLButtonElement>('#mobile-menu-btn');
const nav = document.getElementById('mobile-nav');
if (btn && nav) {
  btn.addEventListener('click', () => {
    const isOpen = nav.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(isOpen));
    nav.setAttribute('aria-hidden', String(!isOpen));
    if (isOpen) {
      nav.querySelector<HTMLAnchorElement>('.mobile-nav-link')?.focus();
      btn.setAttribute('aria-label', 'Close menu');
    } else {
      btn.setAttribute('aria-label', 'Open menu');
      btn.focus();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav.classList.contains('open')) {
      nav.classList.remove('open');
      btn.setAttribute('aria-expanded', 'false');
      nav.setAttribute('aria-hidden', 'true');
      btn.setAttribute('aria-label', 'Open menu');
      btn.focus();
    }
  });

  nav.querySelectorAll('.mobile-nav-link, .mobile-nav-cta, .mobile-nav-phone').forEach(link => {
    link.addEventListener('click', () => {
      nav.classList.remove('open');
      btn.setAttribute('aria-expanded', 'false');
      nav.setAttribute('aria-hidden', 'true');
      btn.setAttribute('aria-label', 'Open menu');
      btn.focus();
    });
  });
}
window.addEventListener('resize', () => {
  if (window.innerWidth >= 1200) {
    document.getElementById('mobile-nav')?.classList.remove('open');
    document.getElementById('mobile-menu-btn')?.setAttribute('aria-expanded', 'false');
    document.getElementById('mobile-nav')?.setAttribute('aria-hidden', 'true');
    document.getElementById('mobile-menu-btn')?.setAttribute('aria-label', 'Open menu');
  }
});
</script>
