# Resend (transactional email — sends lead notifications to Lou)
RESEND_API_KEY=
RESEND_FROM_EMAIL=leads@loushvac.com
RESEND_TO_EMAIL=admin@loushvac.com

# Supabase (lead history)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Housecall Pro: no API on this account. Staff reconcile notification enquiry
# references with the existing tracker and HCP jobs/invoices. No credentials needed.

# Admin (lead history page passcode — choose something strong)
ADMIN_PASSCODE=

# Google Tag Manager activation gate (Netlify production context only).
# Production kill switch. Consent/host/path policy still applies when enabled.
# Per-action conversion configuration is separate from loading the base tag.
GTM_ENABLED=false

# Optional destinations. Empty = not activated. Production build context only.
# These must be the actual owner-supplied identifiers, not example values.
# Website-call label MUST differ from the existing website form action label.
GOOGLE_ADS_WEBSITE_CALL_LABEL=
GA4_MEASUREMENT_ID=
# Website owns dispatch; do not duplicate form/GA4/call configs in GTM.
